# Copy to .env and adjust. All variables use the OCR_ prefix.

# ---------------------------------------------------------------- model
# Any mlx-vlm compatible PaddleOCR-VL build. Other options:
#   OCR_MODEL=mlx-community/PaddleOCR-VL-1.6-4bit
#   OCR_MODEL=mlx-community/PaddleOCR-VL-4bit
OCR_MODEL=mlx-community/PaddleOCR-VL-1.5-4bit

# Task prompt. "OCR:" yields a clean plain-text transcription.
# Free-form instructions switch the model into spotting mode and make it emit
# <|LOC_n|> layout tokens, so leave this alone unless you want that.
OCR_PROMPT=OCR:

# Hard cap on generated tokens per request.
OCR_MAX_TOKENS=4096
OCR_TEMPERATURE=0.0

# ------------------------------------------------------- image resolution
# Vision budget in pixels (must be a multiple of 784 = 28x28).
# 1003520 == 1280*28*28, the value recommended on the PaddleOCR-VL model card
# for the "ocr" task. Lower = faster / less memory, higher = better on dense or
# small print.
OCR_MAX_PIXELS=1003520
OCR_MIN_PIXELS=112896
# Hard ceiling on the longest image edge before OCR (0 disables).
OCR_MAX_IMAGE_DIM=4096

# ------------------------------------------------------------------- pdf
# Render DPI for PDF pages. 150-200 is the useful range; 300 rarely helps and
# costs roughly 2.5x the pixels.
OCR_PDF_DPI=200
OCR_PDF_MAX_PAGES=200

# ---------------------------------------------------------------- server
# Defaults to localhost. Set OCR_HOST=0.0.0.0 to expose on the LAN.
OCR_HOST=127.0.0.1
OCR_PORT=8088

# Apple GPU is a shared resource: keep this at 1 and optimise for
# single-request latency.
OCR_CONCURRENCY=1

# Per-request ceiling in seconds.
OCR_REQUEST_TIMEOUT=300

# Maximum upload size in megabytes.
OCR_MAX_UPLOAD_MB=32

# ------------------------------------------------------------------ misc
OCR_DEBUG=false
# Run one tiny generation at startup so the first real request does not pay
# for kernel compilation.
OCR_WARMUP=true
# Strip residual <|...|> control/layout tokens and collapse 3+ blank lines.
# Visible characters are never altered.
OCR_SANITIZE=true
